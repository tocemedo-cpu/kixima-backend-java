# Variáveis de ambiente — kixima-backend-java (produção standalone)
#
# Este ficheiro é só documentação/modelo — nunca é lido pela aplicação
# directamente (Spring lê o ambiente do processo, não ficheiros .env).
# Copia para `.env` (ou define cada uma no teu orquestrador/painel) e
# preenche; `docker-compose.prod.yml` lê um `.env` neste mesmo formato.
#
# Ver README.md ("Produção standalone") e docs/provisionamento-postgresql.md
# / docs/provisionamento-minio.md para o procedimento completo de cada
# secção. ProducaoStartupGuard recusa o arranque em `prod` sem as variáveis
# marcadas OBRIGATÓRIA.

# --- Perfil -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# --- Base de dados — OBRIGATÓRIA ----------------------------------------
# Ver docs/provisionamento-postgresql.md. Primeiro arranque contra uma base
# vazia: liga FLYWAY_ENABLED=true (desliga depois, ou deixa ligado — é
# idempotente, só aplica migrações novas).
DATABASE_URL_JDBC=jdbc:postgresql://postgres:5432/kixima_java
DATABASE_USER=kixima_java
DATABASE_PASSWORD=
FLYWAY_ENABLED=true
DB_POOL_MAX=5
# DIRECT_URL= — só se precisares de uma ligação directa (sem pooler) separada
# da acima, para pg_dump/backup (ver KIXIMA_JOB_BACKUP_ENABLED mais abaixo).

# --- Segurança — OBRIGATÓRIA ---------------------------------------------
# Gera com, por ex.: openssl rand -base64 48  (precisa de ≥32 caracteres,
# e não pode ser um valor de exemplo como "changeme").
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Domínio(s) real(ais) do frontend em produção — sem isto, ProducaoStartupGuard
# recusa o arranque (CORS/cookie fail-closed).
APP_URL=https://
# CORS_ORIGINS= — alternativa/complemento a APP_URL, lista separada por vírgulas

# --- Armazenamento — OBRIGATÓRIA (decidido: MinIO auto-hospedado) -------
# Ver docs/provisionamento-minio.md.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=kixima-ficheiros
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
# STORAGE_PUBLIC_URL= — só se o MinIO estiver exposto publicamente atrás de TLS
# STORAGE_BACKUP_BUCKET= — bucket SEPARADO (nome diferente do acima), só se
#   ligares KIXIMA_JOB_BACKUP_ENABLED

# --- Email — OBRIGATÓRIA em produção (decidido: Brevo) -------------------
# Por omissão EMAIL_PROVIDER=console só regista no log, não envia nada.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Tem de ser um remetente verificado na conta Brevo.
EMAIL_FROM=notificacoes@kixima.co.ao

# --- Pagamentos: transferência bancária — OBRIGATÓRIA ---------------------
# Sem isto, as subscrições por transferência bancária não têm para onde
# apontar o pagador (fica assinalado como FALHA no ecrã de Prontidão).
KIXIMA_BANCO_IBAN=
KIXIMA_BANCO_TITULAR=
KIXIMA_BANCO_NOME=
KIXIMA_BANCO_SWIFT=
KIXIMA_BANCO_MOEDA=USD

# --- Jobs agendados — decisão operacional, não de segurança --------------
# Ver README.md ("Jobs agendados"). Recomendação do próprio README para
# standalone: ligar tudo except po-robot (que é um add-on comercial, só se
# estiver mesmo à venda).
KIXIMA_JOB_RETENCAO_ENABLED=true
KIXIMA_JOB_EXPIRACAO_APOLICES_ENABLED=true
KIXIMA_JOB_EXPIRACAO_SUBSCRICOES_ENABLED=true
KIXIMA_JOB_LEMBRETES_2FA_ENABLED=true
KIXIMA_JOB_PO_ROBOT_ENABLED=false
# Backup: exige DIRECT_URL + STORAGE_BACKUP_BUCKET + pg_dump na imagem (ver
# nota no Dockerfile/README — a imagem actual NÃO tem postgresql-client).
KIXIMA_JOB_BACKUP_ENABLED=false
BACKUP_CRON=
BACKUP_MAX_IDADE_HORAS=26

# --- AGT (facturação electrónica) — pendência de certificação -------------
# AGT_ENV=hml (homologação) é o valor seguro por omissão — só mudar para o
# ambiente de produção real da AGT depois de certificado.
AGT_ENV=hml
AGT_SOFTWARE_ID=KIXIMA
AGT_SOFTWARE_VERSION=1.0
AGT_SOFTWARE_VALIDATION_NUMBER=
AGT_NIF=
AGT_ESTABLISHMENT_NUMBER=
AGT_SANDBOX_USERNAME=
AGT_SANDBOX_PASSWORD=
# AGT_JWS_PRIVATE_KEY_BASE64= — chave privada JWS, OU deixa AGT_JWS_PRIVATE_KEY_PATH
# a apontar para um ficheiro .pem montado no contentor.
KIXIMA_NIF=
KIXIMA_CERTIFICADO_AGT=

# --- Gateways de pagamento — activar só os que forem mesmo usados --------
# EMIS_* (Multicaixa Express)
EMIS_BASE_URL=
EMIS_POS_ID=
EMIS_TOKEN=
EMIS_CALLBACK_URL=
# PAYPAY_*
PAYPAY_BASE_URL=
PAYPAY_MERCHANT_ID=
PAYPAY_TOKEN=
PAYPAY_CALLBACK_URL=
# BAI_* / BFA_* / STANDARD_BANK_AO_* — um bloco por banco, mesmo padrão
BAI_BASE_URL=
BAI_CLIENT_ID=
BAI_CLIENT_SECRET=
BAI_CALLBACK_URL=
BFA_BASE_URL=
BFA_CLIENT_ID=
BFA_CLIENT_SECRET=
BFA_CALLBACK_URL=
STANDARD_BANK_AO_BASE_URL=
STANDARD_BANK_AO_CLIENT_ID=
STANDARD_BANK_AO_CLIENT_SECRET=
STANDARD_BANK_AO_CALLBACK_URL=

# --- ERP / integrações externas — só se forem usadas ----------------------
# ERP_CONFIG_ENCRYPTION_KEY — AES-256-GCM, 32 bytes em hex (64 caracteres)
ERP_CONFIG_ENCRYPTION_KEY=
INTEGRATION_URL=
INTEGRATION_ADMIN_TOKEN=
KIXIMA_CALLBACK_SECRET=
RABBITMQ_URL=
RABBITMQ_EXCHANGE=kixima.events

# --- Observabilidade — recomendado, não obrigatório -----------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_FRONTEND_DSN=
LOG_LEVEL=INFO

# --- Limites/segurança adicional — já com valores por omissão razoáveis ---
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=60
FORGOT_PASSWORD_RATE_LIMIT=10
CHAT_RATE_LIMIT=60
DB_MAX_ROWS=1000
MFA_REQUIRED_ROLES=ADMIN_SISTEMA,COMPANY_ADMIN
# MFA_ENFORCE_FROM= — data ISO a partir da qual o 2FA passa a obrigatório
#   para os papéis acima (vazio = só recomendado, nunca obrigatório)

# --- Parâmetros de negócio — valores por omissão do application.yml ------
# IMPORTANTE: ao contrário das secções acima, estas variáveis são lidas por
# @Value(...) em BigDecimal/int SEM tratamento de vazio — uma variável
# DEFINIDA mas em branco não cai no valor por omissão (isso só acontece
# quando a variável está mesmo AUSENTE do ambiente), e a aplicação falha a
# arrancar com NullPointerException (confirmado: PlanService.preco(),
# FxService, AddonService, PlatformFeeService todos fazem o mesmo). Por
# isso aqui ficam com o valor por omissão real escrito, nunca em branco —
# ajusta o número, não apagues o valor.
IVA_RATE=0.14
WITHHOLDING_RATE=0.065
KIXIMA_USD_AOA_RATE=900
PAYMENT_SLA_DAYS=5
POLICY_EXPIRY_ALERT_DAYS=30
KIXIMA_GRACE_PERIOD_DAYS=7
KIXIMA_FEE_PER_PO_USD=8
KIXIMA_FEE_PER_INVOICE_USD=15
KIXIMA_FEE_PERCENT_ABOVE=0.002
KIXIMA_FEE_THRESHOLD_USD=11500
KIXIMA_PRECO_BASE_USD=100
KIXIMA_PRECO_BASE_PERIODO=TRIMESTRAL
KIXIMA_PRECO_CORE_USD=100
KIXIMA_PRECO_CORE_PERIODO=MENSAL
KIXIMA_PRECO_PRO_USD=5000
KIXIMA_PRECO_PRO_PERIODO=ANUAL
KIXIMA_PRECO_ADDON_PO_ROBOT_USD=200
KIXIMA_PRECO_ADDON_PO_ROBOT_PERIODO=MENSAL
KIXIMA_SEAT_PRICE_CAP_USD=100

# --- Opcional/degrada graciosamente sem isto -------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
